PREFIX am: <https://w3id.org/active-madrid/ontology#>
PREFIX res: <https://w3id.org/active-madrid/resource/>
PREFIX schema: <http://schema.org/>
PREFIX geo: <http://www.w3.org/2003/01/geo/wgs84_pos#>
PREFIX time: <http://www.w3.org/2006/time#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# Query 1: Count the total number of instances generated by each class

SELECT ?class (COUNT(?individual) AS ?total)
WHERE {
    ?individual a ?class .
}
GROUP BY ?class
ORDER BY DESC(?total)

# Query 2: List sports centers with their address, neighborhood, district and coordinates

SELECT ?facilityName ?streetAddress ?postalCode ?neighborhoodName ?districtName ?lat ?long
WHERE {
    ?facility a am:SportsFacility ;
            schema:name ?facilityName ;
            schema:address ?address ;
            geo:lat ?lat ;
            geo:long ?long .
    
    ?address schema:streetAddress ?streetAddress ;
            schema:postalCode ?postalCode ;
            am:locatedInNeighborhood ?neighborhood .
            
    ?neighborhood a am:Neighborhood ;
            schema:name ?neighborhoodName ;
            am:locatedInDistrict ?district .
            
    ?district a am:District ;
            schema:name ?districtName .
}
LIMIT 20

# Query 3: Sports classes with available places and assigned activity

SELECT ?className ?activityName ?availablePlaces ?offeredPlaces
WHERE {
    ?sportsClass a am:SportsClass ;
                schema:name ?className ;
                am:hasActivity ?activity ;
                am:availablePlaces ?availablePlaces ;
                am:offeredPlaces ?offeredPlaces .
    ?activity schema:name ?activityName .
    FILTER (?availablePlaces > 0)
}
ORDER BY DESC(?availablePlaces)
LIMIT 20

# Query 4: Open class schedules linked to time intervals

SELECT ?className ?startTime ?endTime
WHERE {
    ?sportsClass a am:SportsClass ;
                schema:name ?className ;
                time:hasTime ?interval .
    ?interval a time:Interval ;
            time:hasBeginning ?startTime ;
            time:hasEnd ?endTime .
}
LIMIT 20

# Query 5: Integrity check / Detection of classes without sports center link

SELECT ?unlinkedClass ?className
WHERE {
    ?unlinkedClass a am:SportsClass ;
                    schema:name ?className .
    FILTER NOT EXISTS {
        ?unlinkedClass am:takesPlaceAt ?facility .
    }
}
LIMIT 10

# Query 6: Contact information and postal address for CDM Aluche (PK 4696)

SELECT ?facilityName ?streetAddress ?postalCode ?phone ?email ?lat ?long
WHERE {
    <https://w3id.org/active-madrid/resource/SportsFacility/4696> a am:SportsFacility ;
                            schema:name ?facilityName ;
                            schema:address ?address ;
                            schema:telephone ?phone ;
                            schema:email ?email ;
                            geo:lat ?lat ;
                            geo:long ?long .
    ?address schema:streetAddress ?streetAddress ;
            schema:postalCode ?postalCode .
}

# Query 7: Search activities and classes taught at the Barajas sports center (PK 99578)

SELECT ?className ?activityName ?startTime ?endTime ?offered ?occupied ?available
WHERE {
    ?sportsClass a am:SportsClass ;
                schema:name ?className ;
                am:takesPlaceAt <https://w3id.org/active-madrid/resource/SportsFacility/99578> ;
                am:hasActivity ?activity ;
                time:hasTime ?interval ;
                am:offeredPlaces ?offered ;
                am:occupiedPlaces ?occupied ;
                am:availablePlaces ?available .
    ?activity schema:name ?activityName .
    ?interval time:hasBeginning ?startTime ;
                time:hasEnd ?endTime .
}
LIMIT 20

# Query 8: Locate classes where the "Acondicionamiento Cardiovascular" activity is taught

SELECT ?activityName ?className ?startTime ?endTime ?availablePlaces ?facilityName
WHERE {
    ?sportsClass a am:SportsClass ;
                schema:name ?className ;
                am:availablePlaces ?availablePlaces ;
                time:hasTime ?interval ;
                am:hasActivity ?activity .
    ?activity schema:name ?activityName .
    FILTER (CONTAINS(LCASE(?activityName), "cardiovascular"))
    OPTIONAL {
        ?sportsClass am:takesPlaceAt ?facility .
        ?facility schema:name ?facilityName .
    }
    ?interval time:hasBeginning ?startTime ;
                time:hasEnd ?endTime .
}
LIMIT 20

# Query 9: Classes with availability of places (availability > 0) and occupancy details

SELECT ?className ?activityName ?availablePlaces ?offeredPlaces ?occupiedPlaces
WHERE {
    ?sportsClass a am:SportsClass ;
                schema:name ?className ;
                am:hasActivity ?activity ;
                am:availablePlaces ?availablePlaces ;
                am:offeredPlaces ?offeredPlaces ;
                am:occupiedPlaces ?occupiedPlaces .
    ?activity schema:name ?activityName .
    FILTER (?availablePlaces > 0)
}
ORDER BY DESC(?availablePlaces)
LIMIT 20

# Query 10: Classes that have 100% full capacity (free places = 0)

SELECT ?className ?activityName ?offeredPlaces ?occupiedPlaces
WHERE {
    ?sportsClass a am:SportsClass ;
                schema:name ?className ;
                am:hasActivity ?activity ;
                am:availablePlaces "0"^^xsd:nonNegativeInteger ;
                am:offeredPlaces ?offeredPlaces ;
                am:occupiedPlaces ?occupiedPlaces .
    ?activity schema:name ?activityName .
    FILTER (?offeredPlaces > 0)
}
LIMIT 20

# Query 11: Classes that start in the afternoon (from 15:00:00)

SELECT ?className ?startTime ?endTime
WHERE {
    ?sportsClass a am:SportsClass ;
                schema:name ?className ;
                time:hasTime ?interval .
    ?interval time:hasBeginning ?startTime ;
                time:hasEnd ?endTime .
    FILTER (?startTime >= "15:00:00"^^xsd:time)
}
LIMIT 20

# Query 12: Distribution of sports facilities per neighborhood and district

SELECT ?districtName ?neighborhoodName (COUNT(?facility) AS ?numFacilities)
WHERE {
    ?facility a am:SportsFacility ;
              schema:address ?address .
    ?address am:locatedInNeighborhood ?neighborhood .
    ?neighborhood a am:Neighborhood ;
                  schema:name ?neighborhoodName ;
                  am:locatedInDistrict ?district .
    ?district a am:District ;
              schema:name ?districtName .
}
GROUP BY ?districtName ?neighborhoodName
ORDER BY ?districtName DESC(?numFacilities)
