_:nc8f42d650c1444489fdf7353e0f98a64b20 sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:message "The telephone must contain at least 9 digits." ;
    sh:path hr:telephone ;
    sh:pattern "^[0-9+][0-9 ]{8,}$" .

_:nc8f42d650c1444489fdf7353e0f98a64b7 sh:datatype xsd:string ;
