# =====================================================================
# Group 13 - Queries to verify the links (aparcamientos-with-links.ttl)
# Links: each mp:District is linked to its Wikidata entity via owl:sameAs
# (values come from the "same_as_wikidata_distrito" column, reconciled
#  in OpenRefine against Wikidata).
# =====================================================================

# ---------------------------------------------------------------------
# Q1. List every district together with its Wikidata link
# ---------------------------------------------------------------------
PREFIX mp:   <http://parking.linkeddata.upm.es/ontology/>
PREFIX prop: <http://parking.linkeddata.upm.es/property/>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>

SELECT ?district ?name ?wikidata
WHERE {
  ?district a mp:District ;
            prop:districtName ?name ;
            owl:sameAs ?wikidata .
}
ORDER BY ?name

# ---------------------------------------------------------------------
# Q2. Link coverage: total districts vs. districts with a link
# ---------------------------------------------------------------------
PREFIX mp:  <http://parking.linkeddata.upm.es/ontology/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>

SELECT (COUNT(DISTINCT ?district) AS ?totalDistricts)
       (COUNT(DISTINCT ?linked)   AS ?linkedDistricts)
WHERE {
  ?district a mp:District .
  OPTIONAL { ?district owl:sameAs ?wd . BIND(?district AS ?linked) }
}

# ---------------------------------------------------------------------
# Q3. Districts WITHOUT a link (expected: no results)
# ---------------------------------------------------------------------
PREFIX mp:   <http://parking.linkeddata.upm.es/ontology/>
PREFIX prop: <http://parking.linkeddata.upm.es/property/>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>

SELECT ?district ?name
WHERE {
  ?district a mp:District ;
            prop:districtName ?name .
  FILTER NOT EXISTS { ?district owl:sameAs ?any }
}

# ---------------------------------------------------------------------
# Q4. Districts linked to MORE than one external entity
#     (ambiguous reconciliation; expected: no results)
# ---------------------------------------------------------------------
PREFIX mp:  <http://parking.linkeddata.upm.es/ontology/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>

SELECT ?district (COUNT(DISTINCT ?wd) AS ?numLinks)
WHERE {
  ?district a mp:District ;
            owl:sameAs ?wd .
}
GROUP BY ?district
HAVING (COUNT(DISTINCT ?wd) > 1)

# ---------------------------------------------------------------------
# Q5. The same Wikidata entity used for several districts
#     (wrong reconciliation; expected: no results)
# ---------------------------------------------------------------------
PREFIX mp:  <http://parking.linkeddata.upm.es/ontology/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>

SELECT ?wd (COUNT(DISTINCT ?district) AS ?numDistricts)
WHERE {
  ?district a mp:District ;
            owl:sameAs ?wd .
}
GROUP BY ?wd
HAVING (COUNT(DISTINCT ?district) > 1)

# ---------------------------------------------------------------------
# Q6. Malformed links: not an IRI or not a Wikidata entity IRI
#     (expected: no results)
# ---------------------------------------------------------------------
PREFIX owl: <http://www.w3.org/2002/07/owl#>

SELECT ?s ?link
WHERE {
  ?s owl:sameAs ?link .
  FILTER ( !isIRI(?link) ||
           !STRSTARTS(STR(?link), "http://www.wikidata.org/entity/Q") )
}

# ---------------------------------------------------------------------
# Q7. Follow the links: each parking facility with its district
#     and the district's Wikidata entity
# ---------------------------------------------------------------------
PREFIX mp:   <http://parking.linkeddata.upm.es/ontology/>
PREFIX prop: <http://parking.linkeddata.upm.es/property/>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>

SELECT DISTINCT ?parkingName ?districtName ?wikidata
WHERE {
  ?parking a mp:ParkingFacility ;
           prop:parkingName ?parkingName ;
           prop:locatedIn ?district .
  ?district prop:districtName ?districtName ;
            owl:sameAs ?wikidata .
}
ORDER BY ?districtName ?parkingName

# ---------------------------------------------------------------------
# Q8. Number of parking facilities per linked district
# ---------------------------------------------------------------------
PREFIX mp:   <http://parking.linkeddata.upm.es/ontology/>
PREFIX prop: <http://parking.linkeddata.upm.es/property/>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>

SELECT ?districtName ?wikidata (COUNT(DISTINCT ?parking) AS ?numParkings)
WHERE {
  ?parking a mp:ParkingFacility ;
           prop:locatedIn ?district .
  ?district prop:districtName ?districtName ;
            owl:sameAs ?wikidata .
}
GROUP BY ?districtName ?wikidata
ORDER BY DESC(?numParkings)

# =====================================================================
# Queries from the previous hands-on (queries.sparql)
# =====================================================================

# ---------------------------------------------------------------------
# Q9. Count Parking
# ---------------------------------------------------------------------
PREFIX mp: <http://parking.linkeddata.upm.es/ontology/>

SELECT (COUNT(?parking) AS ?totalParkings)
WHERE {
  ?parking a mp:ParkingFacility .
}

# ---------------------------------------------------------------------
# Q10. Count districts
# ---------------------------------------------------------------------
PREFIX mp: <http://parking.linkeddata.upm.es/ontology/>

SELECT (COUNT(?district) AS ?totalDistricts)
WHERE {
  ?district a mp:District .
}

# ---------------------------------------------------------------------
# Q11. Number of observations
# ---------------------------------------------------------------------
PREFIX mp: <http://parking.linkeddata.upm.es/ontology/>

SELECT (COUNT(?obs) AS ?totalObservations)
WHERE {
  ?obs a mp:OccupancyObservation .
}

# ---------------------------------------------------------------------
# Q12. Names of 10 parking facilities
# ---------------------------------------------------------------------
PREFIX mp: <http://parking.linkeddata.upm.es/ontology/>
PREFIX prop: <http://parking.linkeddata.upm.es/property/>

SELECT ?parking ?name
WHERE {
  ?parking a mp:ParkingFacility ;
           prop:parkingName ?name .
}
LIMIT 10
