@prefix fuseki: <http://jena.apache.org/fuseki#> .
@prefix tdb2: <http://jena.apache.org/2016/tdb#> .

<#service> a fuseki:Service ;
    fuseki:name "parking" ;
    fuseki:endpoint [
        fuseki:operation fuseki:query ;
        fuseki:name "query"
    ] ;
    fuseki:dataset [
        a tdb2:DatasetTDB2 ;
        tdb2:location "runtime/database"
    ] .
