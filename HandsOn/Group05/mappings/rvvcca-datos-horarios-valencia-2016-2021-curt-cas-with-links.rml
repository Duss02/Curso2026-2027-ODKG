# RML mappings with links (Hands-on 5, Group 05) for the hourly air quality data of Valencia.
#
# Input : csv/rvvcca-datos-horarios-valencia-2016-2021-curt-cas-with-links.csv  (stations joined with their page in the GVA air quality network)
#         csv/magnitudes-with-links.csv (measured magnitudes reconciled with Wikidata in OpenRefine)
# Output: rdf/rvvcca-datos-horarios-valencia-2016-2021-curt-cas-with-links.ttl
# Run   : python -m morph_kgc config.ini
#
# Links generated:
#   - city:Valencia        owl:sameAs  wd:Q8818 (Valencia in Wikidata)
#   - ObservableProperty   owl:sameAs  the Wikidata item of the magnitude (18 of 22 magnitudes)
#   - MonitoringStation    rdfs:seeAlso the station page of the GVA network. These pages are HTML
#     documents about the station, not the station itself, so owl:sameAs is not used for them.
#
# The logical sources are SQL queries over the CSV files (executed by Morph-KGC with DuckDB).

@prefix rr:   <http://www.w3.org/ns/r2rml#> .
@prefix rml:  <http://semweb.mmlab.be/ns/rml#> .
@prefix ql:   <http://semweb.mmlab.be/ns/ql#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix aq:   <https://w3id.org/valencia-airquality/ontology/airquality#> .
@prefix city: <https://w3id.org/valencia-airquality/resource/City/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix wd:   <http://www.wikidata.org/entity/> .

<#ObservationsSource>
  rml:referenceFormulation ql:CSV ;
  rml:query """
WITH src AS (
    SELECT trim("Estación") AS station_name,
           trim("uri") AS station_page,
           trim(CAST("Fecha" AS VARCHAR)) AS fecha,
           lpad(split_part(trim("Hora"), ':', 1), 2, '0') AS hh,
           "PM1", "PM2.5", "PM10", "NO", "NO2", "NOx", "O3", "SO2", "CO", "Velocidad del viento", "Dirección del viento", "NH3", "C7H8", "C6H6", "Ruido", "C8H10", "Temperatura", "Humedad relativa", "Presión", "Radiación", "Precipitación", "Velocidad máxima del viento"
    FROM read_csv('csv/rvvcca-datos-horarios-valencia-2016-2021-curt-cas-with-links.csv', header = true, all_varchar = true)
    -- SAMPLE: only 1-15 January 2020 is transformed, so that the Turtle file stays
    -- below GitHub's 25 MB web-upload limit. Remove this WHERE clause to transform the
    -- whole 2016-2021 dataset (about 6 million observations).
    WHERE "Fecha" BETWEEN '2020-01-01' AND '2020-01-15'
),
long AS (
    UNPIVOT src ON "PM1", "PM2.5", "PM10", "NO", "NO2", "NOx", "O3", "SO2", "CO", "Velocidad del viento", "Dirección del viento", "NH3", "C7H8", "C6H6", "Ruido", "C8H10", "Temperatura", "Humedad relativa", "Presión", "Radiación", "Precipitación", "Velocidad máxima del viento" INTO NAME col VALUE val
)
SELECT
    CASE station_name
        WHEN 'Avda. Francia' THEN 'AvdaFrancia'
        WHEN 'Bulevard Sud' THEN 'BulevardSud'
        WHEN 'Consellería Meteo' THEN 'ConselleriaMeteo'
        WHEN 'Pista Silla' THEN 'PistaSilla'
        WHEN 'Politécnico' THEN 'Politecnico'
        WHEN 'Viveros' THEN 'Viveros'
        WHEN 'Molí del Sol' THEN 'MoliDelSol'
        WHEN 'Valencia Centro' THEN 'ValenciaCentro'
        WHEN 'Puerto Valencia' THEN 'PuertoValencia'
        WHEN 'Nazaret Meteo' THEN 'NazaretMeteo'
        WHEN 'Puerto Moll Trans. Ponent' THEN 'PuertoMollTransPonent'
        WHEN 'Puerto llit antic Túria' THEN 'PuertoLlitAnticTuria'
    END AS station_id,
    station_name,
    station_page,
    CASE col
        WHEN 'PM1' THEN 'PM1'
        WHEN 'PM2.5' THEN 'PM2_5'
        WHEN 'PM10' THEN 'PM10'
        WHEN 'NO' THEN 'NO'
        WHEN 'NO2' THEN 'NO2'
        WHEN 'NOx' THEN 'NOx'
        WHEN 'O3' THEN 'O3'
        WHEN 'SO2' THEN 'SO2'
        WHEN 'CO' THEN 'CO'
        WHEN 'Velocidad del viento' THEN 'WindSpeed'
        WHEN 'Dirección del viento' THEN 'WindDirection'
        WHEN 'NH3' THEN 'NH3'
        WHEN 'C7H8' THEN 'C7H8'
        WHEN 'C6H6' THEN 'C6H6'
        WHEN 'Ruido' THEN 'Noise'
        WHEN 'C8H10' THEN 'C8H10'
        WHEN 'Temperatura' THEN 'Temperature'
        WHEN 'Humedad relativa' THEN 'RelativeHumidity'
        WHEN 'Presión' THEN 'Pressure'
        WHEN 'Radiación' THEN 'SolarRadiation'
        WHEN 'Precipitación' THEN 'Precipitation'
        WHEN 'Velocidad máxima del viento' THEN 'MaxWindSpeed'
    END AS property_id,
    CASE col
        WHEN 'PM1' THEN 'Particulate matter PM1'
        WHEN 'PM2.5' THEN 'Particulate matter PM2.5'
        WHEN 'PM10' THEN 'Particulate matter PM10'
        WHEN 'NO' THEN 'Nitric oxide (NO)'
        WHEN 'NO2' THEN 'Nitrogen dioxide (NO2)'
        WHEN 'NOx' THEN 'Nitrogen oxides (NOx)'
        WHEN 'O3' THEN 'Ozone (O3)'
        WHEN 'SO2' THEN 'Sulphur dioxide (SO2)'
        WHEN 'CO' THEN 'Carbon monoxide (CO)'
        WHEN 'Velocidad del viento' THEN 'Wind speed'
        WHEN 'Dirección del viento' THEN 'Wind direction'
        WHEN 'NH3' THEN 'Ammonia (NH3)'
        WHEN 'C7H8' THEN 'Toluene (C7H8)'
        WHEN 'C6H6' THEN 'Benzene (C6H6)'
        WHEN 'Ruido' THEN 'Noise level'
        WHEN 'C8H10' THEN 'Xylene (C8H10)'
        WHEN 'Temperatura' THEN 'Temperature'
        WHEN 'Humedad relativa' THEN 'Relative humidity'
        WHEN 'Presión' THEN 'Atmospheric pressure'
        WHEN 'Radiación' THEN 'Solar radiation'
        WHEN 'Precipitación' THEN 'Precipitation'
        WHEN 'Velocidad máxima del viento' THEN 'Maximum wind speed'
    END AS property_label,
    replace(fecha, '-', '') || 'T' || hh || '00' AS time_id,
    fecha || 'T' || hh || ':00:00' AS result_time,
    trim(val) AS result_value
FROM long
WHERE val IS NOT NULL AND trim(val) <> ''
  -- Physically implausible values found in the analysis (analysis.html, 1.4)
  -- are not transformed into observations.
  AND NOT (col = 'Humedad relativa' AND CAST(val AS DOUBLE) > 100)
  AND NOT (col = 'Radiación' AND CAST(val AS DOUBLE) < 0)
  AND NOT (col = 'Ruido' AND CAST(val AS DOUBLE) > 140)
""" .

<#ObservablePropertiesSource>
  rml:referenceFormulation ql:CSV ;
  rml:query """
SELECT DISTINCT o.property_id, o.property_label, nullif(trim(m.wikidata), '') AS wikidata
FROM (
WITH src AS (
    SELECT trim("Estación") AS station_name,
           trim("uri") AS station_page,
           trim(CAST("Fecha" AS VARCHAR)) AS fecha,
           lpad(split_part(trim("Hora"), ':', 1), 2, '0') AS hh,
           "PM1", "PM2.5", "PM10", "NO", "NO2", "NOx", "O3", "SO2", "CO", "Velocidad del viento", "Dirección del viento", "NH3", "C7H8", "C6H6", "Ruido", "C8H10", "Temperatura", "Humedad relativa", "Presión", "Radiación", "Precipitación", "Velocidad máxima del viento"
    FROM read_csv('csv/rvvcca-datos-horarios-valencia-2016-2021-curt-cas-with-links.csv', header = true, all_varchar = true)
    -- SAMPLE: only 1-15 January 2020 is transformed, so that the Turtle file stays
    -- below GitHub's 25 MB web-upload limit. Remove this WHERE clause to transform the
    -- whole 2016-2021 dataset (about 6 million observations).
    WHERE "Fecha" BETWEEN '2020-01-01' AND '2020-01-15'
),
long AS (
    UNPIVOT src ON "PM1", "PM2.5", "PM10", "NO", "NO2", "NOx", "O3", "SO2", "CO", "Velocidad del viento", "Dirección del viento", "NH3", "C7H8", "C6H6", "Ruido", "C8H10", "Temperatura", "Humedad relativa", "Presión", "Radiación", "Precipitación", "Velocidad máxima del viento" INTO NAME col VALUE val
)
SELECT
    CASE station_name
        WHEN 'Avda. Francia' THEN 'AvdaFrancia'
        WHEN 'Bulevard Sud' THEN 'BulevardSud'
        WHEN 'Consellería Meteo' THEN 'ConselleriaMeteo'
        WHEN 'Pista Silla' THEN 'PistaSilla'
        WHEN 'Politécnico' THEN 'Politecnico'
        WHEN 'Viveros' THEN 'Viveros'
        WHEN 'Molí del Sol' THEN 'MoliDelSol'
        WHEN 'Valencia Centro' THEN 'ValenciaCentro'
        WHEN 'Puerto Valencia' THEN 'PuertoValencia'
        WHEN 'Nazaret Meteo' THEN 'NazaretMeteo'
        WHEN 'Puerto Moll Trans. Ponent' THEN 'PuertoMollTransPonent'
        WHEN 'Puerto llit antic Túria' THEN 'PuertoLlitAnticTuria'
    END AS station_id,
    station_name,
    station_page,
    CASE col
        WHEN 'PM1' THEN 'PM1'
        WHEN 'PM2.5' THEN 'PM2_5'
        WHEN 'PM10' THEN 'PM10'
        WHEN 'NO' THEN 'NO'
        WHEN 'NO2' THEN 'NO2'
        WHEN 'NOx' THEN 'NOx'
        WHEN 'O3' THEN 'O3'
        WHEN 'SO2' THEN 'SO2'
        WHEN 'CO' THEN 'CO'
        WHEN 'Velocidad del viento' THEN 'WindSpeed'
        WHEN 'Dirección del viento' THEN 'WindDirection'
        WHEN 'NH3' THEN 'NH3'
        WHEN 'C7H8' THEN 'C7H8'
        WHEN 'C6H6' THEN 'C6H6'
        WHEN 'Ruido' THEN 'Noise'
        WHEN 'C8H10' THEN 'C8H10'
        WHEN 'Temperatura' THEN 'Temperature'
        WHEN 'Humedad relativa' THEN 'RelativeHumidity'
        WHEN 'Presión' THEN 'Pressure'
        WHEN 'Radiación' THEN 'SolarRadiation'
        WHEN 'Precipitación' THEN 'Precipitation'
        WHEN 'Velocidad máxima del viento' THEN 'MaxWindSpeed'
    END AS property_id,
    CASE col
        WHEN 'PM1' THEN 'Particulate matter PM1'
        WHEN 'PM2.5' THEN 'Particulate matter PM2.5'
        WHEN 'PM10' THEN 'Particulate matter PM10'
        WHEN 'NO' THEN 'Nitric oxide (NO)'
        WHEN 'NO2' THEN 'Nitrogen dioxide (NO2)'
        WHEN 'NOx' THEN 'Nitrogen oxides (NOx)'
        WHEN 'O3' THEN 'Ozone (O3)'
        WHEN 'SO2' THEN 'Sulphur dioxide (SO2)'
        WHEN 'CO' THEN 'Carbon monoxide (CO)'
        WHEN 'Velocidad del viento' THEN 'Wind speed'
        WHEN 'Dirección del viento' THEN 'Wind direction'
        WHEN 'NH3' THEN 'Ammonia (NH3)'
        WHEN 'C7H8' THEN 'Toluene (C7H8)'
        WHEN 'C6H6' THEN 'Benzene (C6H6)'
        WHEN 'Ruido' THEN 'Noise level'
        WHEN 'C8H10' THEN 'Xylene (C8H10)'
        WHEN 'Temperatura' THEN 'Temperature'
        WHEN 'Humedad relativa' THEN 'Relative humidity'
        WHEN 'Presión' THEN 'Atmospheric pressure'
        WHEN 'Radiación' THEN 'Solar radiation'
        WHEN 'Precipitación' THEN 'Precipitation'
        WHEN 'Velocidad máxima del viento' THEN 'Maximum wind speed'
    END AS property_label,
    replace(fecha, '-', '') || 'T' || hh || '00' AS time_id,
    fecha || 'T' || hh || ':00:00' AS result_time,
    trim(val) AS result_value
FROM long
WHERE val IS NOT NULL AND trim(val) <> ''
  -- Physically implausible values found in the analysis (analysis.html, 1.4)
  -- are not transformed into observations.
  AND NOT (col = 'Humedad relativa' AND CAST(val AS DOUBLE) > 100)
  AND NOT (col = 'Radiación' AND CAST(val AS DOUBLE) < 0)
  AND NOT (col = 'Ruido' AND CAST(val AS DOUBLE) > 140)
) AS o
LEFT JOIN read_csv('csv/magnitudes-with-links.csv', header = true, all_varchar = true) AS m
  ON o.property_id = trim(m.property_id)
""" .

<#ObservablePropertyLinksSource>
  rml:referenceFormulation ql:CSV ;
  rml:query """
SELECT DISTINCT o.property_id, o.property_label, nullif(trim(m.wikidata), '') AS wikidata
FROM (
WITH src AS (
    SELECT trim("Estación") AS station_name,
           trim("uri") AS station_page,
           trim(CAST("Fecha" AS VARCHAR)) AS fecha,
           lpad(split_part(trim("Hora"), ':', 1), 2, '0') AS hh,
           "PM1", "PM2.5", "PM10", "NO", "NO2", "NOx", "O3", "SO2", "CO", "Velocidad del viento", "Dirección del viento", "NH3", "C7H8", "C6H6", "Ruido", "C8H10", "Temperatura", "Humedad relativa", "Presión", "Radiación", "Precipitación", "Velocidad máxima del viento"
    FROM read_csv('csv/rvvcca-datos-horarios-valencia-2016-2021-curt-cas-with-links.csv', header = true, all_varchar = true)
    -- SAMPLE: only 1-15 January 2020 is transformed, so that the Turtle file stays
    -- below GitHub's 25 MB web-upload limit. Remove this WHERE clause to transform the
    -- whole 2016-2021 dataset (about 6 million observations).
    WHERE "Fecha" BETWEEN '2020-01-01' AND '2020-01-15'
),
long AS (
    UNPIVOT src ON "PM1", "PM2.5", "PM10", "NO", "NO2", "NOx", "O3", "SO2", "CO", "Velocidad del viento", "Dirección del viento", "NH3", "C7H8", "C6H6", "Ruido", "C8H10", "Temperatura", "Humedad relativa", "Presión", "Radiación", "Precipitación", "Velocidad máxima del viento" INTO NAME col VALUE val
)
SELECT
    CASE station_name
        WHEN 'Avda. Francia' THEN 'AvdaFrancia'
        WHEN 'Bulevard Sud' THEN 'BulevardSud'
        WHEN 'Consellería Meteo' THEN 'ConselleriaMeteo'
        WHEN 'Pista Silla' THEN 'PistaSilla'
        WHEN 'Politécnico' THEN 'Politecnico'
        WHEN 'Viveros' THEN 'Viveros'
        WHEN 'Molí del Sol' THEN 'MoliDelSol'
        WHEN 'Valencia Centro' THEN 'ValenciaCentro'
        WHEN 'Puerto Valencia' THEN 'PuertoValencia'
        WHEN 'Nazaret Meteo' THEN 'NazaretMeteo'
        WHEN 'Puerto Moll Trans. Ponent' THEN 'PuertoMollTransPonent'
        WHEN 'Puerto llit antic Túria' THEN 'PuertoLlitAnticTuria'
    END AS station_id,
    station_name,
    station_page,
    CASE col
        WHEN 'PM1' THEN 'PM1'
        WHEN 'PM2.5' THEN 'PM2_5'
        WHEN 'PM10' THEN 'PM10'
        WHEN 'NO' THEN 'NO'
        WHEN 'NO2' THEN 'NO2'
        WHEN 'NOx' THEN 'NOx'
        WHEN 'O3' THEN 'O3'
        WHEN 'SO2' THEN 'SO2'
        WHEN 'CO' THEN 'CO'
        WHEN 'Velocidad del viento' THEN 'WindSpeed'
        WHEN 'Dirección del viento' THEN 'WindDirection'
        WHEN 'NH3' THEN 'NH3'
        WHEN 'C7H8' THEN 'C7H8'
        WHEN 'C6H6' THEN 'C6H6'
        WHEN 'Ruido' THEN 'Noise'
        WHEN 'C8H10' THEN 'C8H10'
        WHEN 'Temperatura' THEN 'Temperature'
        WHEN 'Humedad relativa' THEN 'RelativeHumidity'
        WHEN 'Presión' THEN 'Pressure'
        WHEN 'Radiación' THEN 'SolarRadiation'
        WHEN 'Precipitación' THEN 'Precipitation'
        WHEN 'Velocidad máxima del viento' THEN 'MaxWindSpeed'
    END AS property_id,
    CASE col
        WHEN 'PM1' THEN 'Particulate matter PM1'
        WHEN 'PM2.5' THEN 'Particulate matter PM2.5'
        WHEN 'PM10' THEN 'Particulate matter PM10'
        WHEN 'NO' THEN 'Nitric oxide (NO)'
        WHEN 'NO2' THEN 'Nitrogen dioxide (NO2)'
        WHEN 'NOx' THEN 'Nitrogen oxides (NOx)'
        WHEN 'O3' THEN 'Ozone (O3)'
        WHEN 'SO2' THEN 'Sulphur dioxide (SO2)'
        WHEN 'CO' THEN 'Carbon monoxide (CO)'
        WHEN 'Velocidad del viento' THEN 'Wind speed'
        WHEN 'Dirección del viento' THEN 'Wind direction'
        WHEN 'NH3' THEN 'Ammonia (NH3)'
        WHEN 'C7H8' THEN 'Toluene (C7H8)'
        WHEN 'C6H6' THEN 'Benzene (C6H6)'
        WHEN 'Ruido' THEN 'Noise level'
        WHEN 'C8H10' THEN 'Xylene (C8H10)'
        WHEN 'Temperatura' THEN 'Temperature'
        WHEN 'Humedad relativa' THEN 'Relative humidity'
        WHEN 'Presión' THEN 'Atmospheric pressure'
        WHEN 'Radiación' THEN 'Solar radiation'
        WHEN 'Precipitación' THEN 'Precipitation'
        WHEN 'Velocidad máxima del viento' THEN 'Maximum wind speed'
    END AS property_label,
    replace(fecha, '-', '') || 'T' || hh || '00' AS time_id,
    fecha || 'T' || hh || ':00:00' AS result_time,
    trim(val) AS result_value
FROM long
WHERE val IS NOT NULL AND trim(val) <> ''
  -- Physically implausible values found in the analysis (analysis.html, 1.4)
  -- are not transformed into observations.
  AND NOT (col = 'Humedad relativa' AND CAST(val AS DOUBLE) > 100)
  AND NOT (col = 'Radiación' AND CAST(val AS DOUBLE) < 0)
  AND NOT (col = 'Ruido' AND CAST(val AS DOUBLE) > 140)
) AS o
LEFT JOIN read_csv('csv/magnitudes-with-links.csv', header = true, all_varchar = true) AS m
  ON o.property_id = trim(m.property_id)
WHERE nullif(trim(m.wikidata), '') IS NOT NULL
""" .

# --- Observations (one per non-empty measured value) ----------------------------
<#ObservationMap>
  a rr:TriplesMap ;
  rml:logicalSource <#ObservationsSource> ;
  rr:subjectMap [
    rr:template "https://w3id.org/valencia-airquality/resource/Observation/{station_id}_{time_id}_{property_id}" ;
    rr:class aq:Observation
  ] ;
  rr:predicateObjectMap [
    rr:predicate rdfs:label ;
    rr:objectMap [ rr:template "{property_label} at {station_name}, {result_time}" ; rr:termType rr:Literal ; rr:datatype xsd:string ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate aq:hasStation ;
    rr:objectMap [ rr:template "https://w3id.org/valencia-airquality/resource/MonitoringStation/{station_id}" ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate aq:observedProperty ;
    rr:objectMap [ rr:template "https://w3id.org/valencia-airquality/resource/ObservableProperty/{property_id}" ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate aq:resultTime ;
    rr:objectMap [ rml:reference "result_time" ; rr:datatype xsd:dateTime ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate aq:resultValue ;
    rr:objectMap [ rml:reference "result_value" ; rr:datatype xsd:decimal ]
  ] .

# --- Monitoring stations ---------------------------------------------------------
<#MonitoringStationMap>
  a rr:TriplesMap ;
  rml:logicalSource <#ObservationsSource> ;
  rr:subjectMap [
    rr:template "https://w3id.org/valencia-airquality/resource/MonitoringStation/{station_id}" ;
    rr:class aq:MonitoringStation
  ] ;
  rr:predicateObjectMap [
    rr:predicate rdfs:label ;
    rr:objectMap [ rml:reference "station_name" ; rr:datatype xsd:string ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate aq:stationName ;
    rr:objectMap [ rml:reference "station_name" ; rr:datatype xsd:string ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate aq:locatedInCity ;
    rr:objectMap [ rr:constant city:Valencia ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate rdfs:seeAlso ;
    rr:objectMap [ rml:reference "station_page" ; rr:termType rr:IRI ]
  ] .

# --- Observable properties (pollutants and meteorological variables) ------------
<#ObservablePropertyMap>
  a rr:TriplesMap ;
  rml:logicalSource <#ObservablePropertiesSource> ;
  rr:subjectMap [
    rr:template "https://w3id.org/valencia-airquality/resource/ObservableProperty/{property_id}" ;
    rr:class aq:ObservableProperty
  ] ;
  rr:predicateObjectMap [
    rr:predicate rdfs:label ;
    rr:objectMap [ rml:reference "property_label" ; rr:datatype xsd:string ]
  ] .

# --- Links of the observable properties to Wikidata (only the 18 reconciled ones) ---
<#ObservablePropertyLinkMap>
  a rr:TriplesMap ;
  rml:logicalSource <#ObservablePropertyLinksSource> ;
  rr:subjectMap [
    rr:template "https://w3id.org/valencia-airquality/resource/ObservableProperty/{property_id}"
  ] ;
  rr:predicateObjectMap [
    rr:predicate owl:sameAs ;
    rr:objectMap [ rml:reference "wikidata" ; rr:termType rr:IRI ]
  ] .

# --- City (all the stations are in Valencia) ------------------------------------
<#CityMap>
  a rr:TriplesMap ;
  rml:logicalSource <#ObservationsSource> ;
  rr:subjectMap [
    rr:constant city:Valencia ;
    rr:class aq:City
  ] ;
  rr:predicateObjectMap [
    rr:predicate rdfs:label ;
    rr:objectMap [ rr:constant "Valencia" ; rr:datatype xsd:string ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate owl:sameAs ;
    rr:objectMap [ rr:constant wd:Q8818 ]
  ] .
