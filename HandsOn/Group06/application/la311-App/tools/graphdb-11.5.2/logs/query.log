<?xml version='1.0'?>
<query includeInferred='true' maxExecutionTime='0'>
	<body>PREFIX la311:  &lt;http://linkeddata.la311.com/ontology#&gt;
PREFIX rdf:    &lt;http://www.w3.org/1999/02/22-rdf-syntax-ns#&gt;
PREFIX rdfs:   &lt;http://www.w3.org/2000/01/rdf-schema#&gt;
PREFIX owl:    &lt;http://www.w3.org/2002/07/owl#&gt;
PREFIX xsd:    &lt;http://www.w3.org/2001/XMLSchema#&gt;
PREFIX geo:    &lt;http://www.opengis.net/ont/geosparql#&gt;
PREFIX schema: &lt;http://schema.org/&gt;
PREFIX wd:     &lt;http://www.wikidata.org/entity/&gt;
PREFIX wdt:    &lt;http://www.wikidata.org/prop/direct/&gt;

# Step 2: ONE query joining LA 311 request counts with council-member data from Wikidata.
SELECT ?cd ?n ?openOrPending ?member
       (SAMPLE(?nm) AS ?name) (SAMPLE(?ds) AS ?description) (SAMPLE(?img) AS ?image)
       (GROUP_CONCAT(DISTINCT ?pl; separator=", ") AS ?party) (SAMPLE(?art) AS ?article)
WHERE {
  {
    SELECT ?cd ?m (COUNT(?sr) AS ?n) (SUM(IF(?status IN ("Open", "Pending"), 1, 0)) AS ?openOrPending)
    WHERE {
      ?sr la311:requestType ?requestType ;
          la311:status ?status ;
          la311:createdDate ?created ;
          la311:hasLocation ?loc .
      ?loc la311:isWithin ?region .
      ?region la311:cd ?cd .
      FILTER (?cd != 0)
      OPTIONAL { ?region la311:cdMember ?m }
      FILTER (?created &gt;= "2025-01-01T00:00:00Z"^^xsd:dateTime &amp;&amp; ?created &lt; "2026-01-01T00:00:00Z"^^xsd:dateTime)
    }
    GROUP BY ?cd ?m
  }
  # Districts without a link stay in the result with a placeholder IRI.
  BIND (COALESCE(?m, &lt;urn:la311:not-linked&gt;) AS ?member)
  OPTIONAL {
    SERVICE &lt;https://query.wikidata.org/sparql&gt; {
      VALUES ?member { wd:Q131101480 wd:Q30122916 wd:Q115327492 wd:Q20638114 wd:Q115471735 wd:Q113686955 wd:Q117101867 wd:Q4685737 wd:Q4931858 wd:Q115238364 wd:Q120064371 wd:Q100728314 wd:Q112652355 }
      OPTIONAL { ?member rdfs:label ?nm . FILTER (LANG(?nm) IN ("en", "mul")) }
      OPTIONAL { ?member schema:description ?ds . FILTER (LANG(?ds) = "en") }
      OPTIONAL { ?member wdt:P18 ?img }
      OPTIONAL { ?member wdt:P102 ?p . ?p rdfs:label ?pl . FILTER (LANG(?pl) = "en") }
      OPTIONAL { ?art schema:about ?member ; schema:isPartOf &lt;https://en.wikipedia.org/&gt; }
    }
  }
}
GROUP BY ?cd ?n ?openOrPending ?member
ORDER BY DESC(?n)
</body>
</query>

