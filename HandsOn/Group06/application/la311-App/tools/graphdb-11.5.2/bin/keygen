#!/bin/bash

source "`dirname "$0"`/setvars.in.sh"

mainclass="com.ontotext.trree.entitypool.impl.storage.encryption.SecretKeyGenerator"

launch_tool()
{
  javaProps=$1
  commandLineProps=$2

  exec "$JAVA" "${JAVA_OPTS_ARRAY[@]}" $GDB_JAVA_OPTS -Dgraphdb.dist="$GDB_DIST" -cp "$GDB_CLASSPATH" $javaProps $mainclass $commandLineProps
}

while [ $# -gt 0 ]
do
    case $1 in
        -X*)
            properties="$properties $1"
            shift
        ;;
        -D*)
            properties="$properties $1"
            shift
        ;;
        *)
            commandLineProperties="$commandLineProperties $1"
            shift
        ;;
    esac
done

launch_tool "$properties" "$commandLineProperties"

exit $?
