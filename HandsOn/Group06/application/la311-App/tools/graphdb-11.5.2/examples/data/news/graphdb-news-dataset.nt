nst\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"http://ontology.ontotext.com/resource/tsng6tvbf2tc\"}},{\"name\":{\"type\":\"XS_STRING\",\"name\":\"personStr\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"de Mistura\"}},{\"name\":{\"type\":\"XS_STRING\",\"name\":\"quotationStr\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"\\\"Do you remember Srebrenica? We do. We never forgot and probably we never forgave ourselves. When there is an imminent threat to civilians, we cannot, we should not, be silent.\\\"\"}},{\"name\":{\"type\":\"XS_STRING\",\"name\":\"relType\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"RelationPersonQuotation\"}},{\"name\":{\"type\":\"XS_STRING\",\"name\":\"rule\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"PersQuote1\"}},{\"name\":{\"type\":\"XS_STRING\",\"name\":\"class\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"http://ontology.ontotext.com/taxonomy/RelationPersonQuotation\"}},{\"name\":{\"type\":\"XS_STRING\",\"name\":\"inst\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"http://data.ontotext.com/publishing/RelationPersonQuotation/_do_you_remember_srebrenica_we_do_we_never_forgot_and_probably_we_never_forgave_ourselves_said_de_mistura_the_u_n_peace_envoy_for_syria_when_there_is_an_imminent_threat_to_civilians_we_cannot_we_should_not_be_silent_\"}},{\"name\":{\"type\":\"XS_STRING\",\"name\":\"string\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"\\\"Do you remember Srebrenica? We do. We never forgot and probably we never forgave ourselves,\\\" said de Mistura, the U.N. peace envoy for Syria. \\\"When there is an imminent threat to civilians, we cannot, we should not, be silent.\\\"\"}}],\"id\":\"50312\",\"startnode\":\"1056\",\"endnode\":\"1284\",\"type\":\"RelationPersonQuotation\",\"status\":\"Suggested\",\"generated\":false},{\"feature-set\":[{\"name\":{\"type\":\"XS_STRING\",\"name\":\"personInst\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"http://data.ontotext.com/publishing/person/Ocalan_Iso\"}},{\"name\":{\"type\":\"XS_STRING\",\"name\":\"personStr\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"Ocalan Iso\"}},{\"name\":{\"type\":\"XS_STRING\",\"name\":\"quotationStr\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"\\\"There are fierce clashes and they are bombing the centre of Kobani from afar,\\\"\"}},{\"name\":{\"type\":\"XS_STRING\",\"name\":\"relType\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"RelationPersonQuotation\"}},{\"name\":{\"type\":\"XS_STRING\",\"name\":\"rule\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"PersQuote2\"}},{\"name\":{\"type\":\"XS_STRING\",\"name\":\"class\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"http://ontology.ontotext.com/taxonomy/RelationPersonQuotation\"}},{\"name\":{\"type\":\"XS_STRING\",\"name\":\"inst\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"http://data.ontotext.com/publishing/RelationPersonQuotation/_there_are_fierce_clashes_and_they_are_bombing_the_centre_of_kobani_from_afar_he_said\"}},{\"name\":{\"type\":\"XS_STRING\",\"name\":\"string\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"\\\"There are fierce clashes and they are bombing the centre of Kobani from afar,\\\" he said\"}}],\"id\":\"50313\",\"startnode\":\"3043\",\"endnode\":\"3130\",\"type\":\"RelationPersonQuotation\",\"status\":\"Suggested\",\"generated\":false},{\"feature-set\":[{\"name\":{\"type\":\"XS_STRING\",\"name\":\"personInst\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"http://ontology.ontotext.com/resource/tsk8d9cjyubk\"}},{\"name\":{\"type\":\"XS_STRING\",\"name\":\"personStr\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"Erdogan\"}},{\"name\":{\"type\":\"XS_STRING\",\"name\":\"quotationStr\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"\\\"The peace process does not mean tolerating illegality. I have put my hand, my body and my life into this peace process ... and I will continue to fight until my last breath to restore the brotherhood of 77 million at any cost.\\\"\"}},{\"name\":{\"type\":\"XS_STRING\",\"name\":\"relType\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"RelationPersonQuotation\"}},{\"name\":{\"type\":\"XS_STRING\",\"name\":\"rule\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"PersQuote2\"}},{\"name\":{\"type\":\"XS_STRING\",\"name\":\"class\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"http://ontology.ontotext.com/taxonomy/RelationPersonQuotation\"}},{\"name\":{\"type\":\"XS_STRING\",\"name\":\"inst\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"http://data.ontotext.com/publishing/RelationPersonQuotation/_the_peace_process_does_not_mean_tolerating_illegality_he_said_i_have_put_my_hand_my_body_and_my_life_into_this_peace_process_and_i_will_continue_to_fight_until_my_last_breath_to_restore_the_brotherhood_of_77_million_at_any_cost_\"}},{\"name\":{\"type\":\"XS_STRING\",\"name\":\"string\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"\\\"The peace process does not mean tolerating illegality,\\\" he said. \\\"I have put my hand, my body and my life into this peace process ... and I will continue to fight until my last breath to restore the brotherhood of 77 million at any cost.\\\"\"}}],\"id\":\"50314\",\"startnode\":\"4949\",\"endnode\":\"5188\",\"type\":\"RelationPersonQuotation\",\"status\":\"Suggested\",\"generated\":false},{\"feature-set\":[{\"name\":{\"type\":\"XS_STRING\",\"name\":\"personInst\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"http://data.ontotext.com/publishing/person/Ahmet_Encu\"}},{\"name\":{\"type\":\"XS_STRING\",\"name\":\"personStr\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"Ahmet Encu\"}},{\"name\":{\"type\":\"XS_STRING\",\"name\":\"quotationStr\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"\\\"I believed in the peace process, because I didn't want any more children to die. But the Kurds were fooled. The peace process was insincere. The government either wants to wipe out Kurds or to enslave them,\\\"\"}},{\"name\":{\"type\":\"XS_STRING\",\"name\":\"relType\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"RelationPersonQuotation\