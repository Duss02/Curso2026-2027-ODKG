:\"XS_STRING\",\"value\":\"http://ontology.ontotext.com/resource/tsm4v4gixmo0\"}},{\"name\":{\"type\":\"XS_STRING\",\"name\":\"personStr\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"Janet Yang\"}},{\"name\":{\"type\":\"XS_STRING\",\"name\":\"quotationStr\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"\\\"The shared characteristic these funds have is they have not been doing so well since 2008. The question is if the markets had gone down, would they have made these changes?\\\"\"}},{\"name\":{\"type\":\"XS_STRING\",\"name\":\"relType\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"RelationPersonQuotation\"}},{\"name\":{\"type\":\"XS_STRING\",\"name\":\"rule\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"PersQuote1\"}},{\"name\":{\"type\":\"XS_STRING\",\"name\":\"class\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"http://ontology.ontotext.com/taxonomy/RelationPersonQuotation\"}},{\"name\":{\"type\":\"XS_STRING\",\"name\":\"inst\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"http://data.ontotext.com/publishing/RelationPersonQuotation/_the_shared_characteristic_these_funds_have_is_they_have_not_been_doing_so_well_since_2008_said_janet_yang_a_fund_analyst_at_morningstar_the_question_is_if_the_markets_had_gone_down_would_they_have_made_these_changes_\"}},{\"name\":{\"type\":\"XS_STRING\",\"name\":\"string\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"\\\"The shared characteristic these funds have is they have not been doing so well since 2008,\\\" said Janet Yang, a fund analyst at Morningstar. \\\"The question is if the markets had gone down, would they have made these changes?\\\"\"}}],\"id\":\"49483\",\"startnode\":\"1560\",\"endnode\":\"1784\",\"type\":\"RelationPersonQuotation\",\"status\":\"Suggested\",\"generated\":false},{\"feature-set\":[{\"name\":{\"type\":\"XS_STRING\",\"name\":\"personInst\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"http://data.ontotext.com/publishing/person/Lori_Lucas\"}},{\"name\":{\"type\":\"XS_STRING\",\"name\":\"personStr\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"Lori Lucas\"}},{\"name\":{\"type\":\"XS_STRING\",\"name\":\"quotationStr\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"\\\"Our concern is that this is happening after a pretty good run in the equity market. If it's a reaction to the fact that some target date funds haven't been competitive then it is a concern.\\\"\"}},{\"name\":{\"type\":\"XS_STRING\",\"name\":\"relType\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"RelationPersonQuotation\"}},{\"name\":{\"type\":\"XS_STRING\",\"name\":\"rule\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"PersQuote1\"}},{\"name\":{\"type\":\"XS_STRING\",\"name\":\"class\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"http://ontology.ontotext.com/taxonomy/RelationPersonQuotation\"}},{\"name\":{\"type\":\"XS_STRING\",\"name\":\"inst\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"http://data.ontotext.com/publishing/RelationPersonQuotation/_our_concern_is_that_this_is_happening_after_a_pretty_good_run_in_the_equity_market_said_lori_lucas_defined_contribution_practice_leader_at_callan_associates_a_san_francisco_based_consultant_to_institutional_investors_if_it_s_a_reaction_to_the_fact_that_some_target_date_funds_haven_t_been_competitive_then_it_is_a_concern_\"}},{\"name\":{\"type\":\"XS_STRING\",\"name\":\"string\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"\\\"Our concern is that this is happening after a pretty good run in the equity market,\\\" said Lori Lucas, defined contribution practice leader at Callan Associates, a San Francisco-based consultant to institutional investors. \\\"If it's a reaction to the fact that some target date funds haven't been competitive then it is a concern.\\\"\"}}],\"id\":\"49484\",\"startnode\":\"3081\",\"endnode\":\"3411\",\"type\":\"RelationPersonQuotation\",\"status\":\"Suggested\",\"generated\":false},{\"feature-set\":[{\"name\":{\"type\":\"XS_STRING\",\"name\":\"personInst\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"http://data.ontotext.com/publishing/person/Chip_Castille\"}},{\"name\":{\"type\":\"XS_STRING\",\"name\":\"personStr\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"Chip Castille\"}},{\"name\":{\"type\":\"XS_STRING\",\"name\":\"quotationStr\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"\\\"There is some kind of expectation that we are making these changes because of the equity markets or because of what competitors are doing and that is incorrect,\\\"\"}},{\"name\":{\"type\":\"XS_STRING\",\"name\":\"relType\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"RelationPersonQuotation\"}},{\"name\":{\"type\":\"XS_STRING\",\"name\":\"rule\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"PersQuote1\"}},{\"name\":{\"type\":\"XS_STRING\",\"name\":\"class\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"http://ontology.ontotext.com/taxonomy/RelationPersonQuotation\"}},{\"name\":{\"type\":\"XS_STRING\",\"name\":\"inst\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"http://data.ontotext.com/publishing/RelationPersonQuotation/_there_is_some_kind_of_expectation_that_we_are_making_these_changes_because_of_the_equity_markets_or_because_of_what_competitors_are_doing_and_that_is_incorrect_said_chip_castille\"}},{\"name\":{\"type\":\"XS_STRING\",\"name\":\"string\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"\\\"There is some kind of expectation that we are making these changes because of the equity markets or because of what competitors are doing and that is incorrect,\\\" said Chip Castille\"}}],\"id\":\"49485\",\"startnode\":\"4734\",\"endnode\":\"4915\",\"type\":\"RelationPersonQuotation\",\"status\":\"Suggested\",\"generated\":false},{\"feature-set\":[{\"name\":{\"type\":\"XS_STRING\",\"name\":\"personInst\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"http://data.ontotext.com/publishing/person/Mathew_Jensen\"}},{\"name\":{\"type\":\"XS_STRING\",\"name\":\"personStr\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"Jensen\"}},{\"name\":{\"type\":\"XS_STRING\",\"name\":\"quotationStr\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"\\\"None of our work was saying 'hey the equity markets did well, we should be in equities. It was about if we have a dollar today, how do we want to put it to work based on what our capital markets assumptions are telling us.\\\"\"}},{\"name\":{\"type\":\"XS_STRING\",\"name\":\"relType\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"RelationPersonQuotation\"}},{\"name\":{\"type\":\"XS_STRING\",\"name\":\"rule\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"PersQuote2\"}},{\"name\":{\"type\":\"XS_STRING\",\"name\":\"class\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"http://ontology.ontotext.com/taxonomy/RelationPersonQuotation\"}},{\"name\":{\"type\":\"XS_STRING\",\"name\":\"inst\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"http://data.ontotext.com/publishing/RelationPersonQuotation/_none_of_our_work_was_saying_hey_the_equity_markets_did_well_we_should_be_in_equities_jensen_said_it_was_about_if_we_have_a_dollar_today_how_do_we_want_to_put_it_to_work_based_on_what_our_capital_markets_assumptions_are_telling_us_\"}},{\"name\":{\"type\":\"XS_STRING\",\"name\":\"string\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"\\\"None of our work was saying 'hey the equity markets did well, we should be in equities,\\\" Jensen said. \\\"It was about if we have a dollar today, how do we want to put it to work based on what our capital markets assumptions are telling us.\\\"\"}}],\"id\":\"49486\",\"startnode\":\"6685\",\"endnode\":\"6924\",\"type\":\"RelationPersonQuotation\",\"status\":\"Suggested\",\"generated\":false},{\"feature-set\":[{\"name\":{\"type\":\"XS_STRING\",\"name\":\"personInst\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"http://data.ontotext.com/publishing/person/John_Miller\"}},{\"name\":{\"type\":\"XS_STRING\",\"name\":\"personStr\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"John Miller\"}},{\"name\":{\"type\":\"XS_STRING\",\"name\":\"quotationStr\"},\"value\":{\"type\":\"XS_STRING\",\"value\