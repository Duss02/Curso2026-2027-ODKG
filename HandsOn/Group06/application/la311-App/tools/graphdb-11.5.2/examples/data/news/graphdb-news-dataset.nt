he_s_a_marcel_proust_of_our_time_peter_englund\"}},{\"name\":{\"type\":\"XS_STRING\",\"name\":\"string\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"\\\"You could say he's a Marcel Proust of our time,\\\" Peter Englund\"}}],\"id\":\"30651\",\"startnode\":\"644\",\"endnode\":\"707\",\"type\":\"RelationPersonQuotation\",\"status\":\"Suggested\",\"generated\":false},{\"feature-set\":[{\"name\":{\"type\":\"XS_STRING\",\"name\":\"personInst\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"http://ontology.ontotext.com/resource/tsk803t3db0g\"}},{\"name\":{\"type\":\"XS_STRING\",\"name\":\"personStr\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"Modiano\"}},{\"name\":{\"type\":\"XS_STRING\",\"name\":\"quotationStr\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"\\\"What I am keen to see are the reasons why they chose me ... One can never really be one's own reader. Even more so because I have the impression of writing the same book for 45 years.\\\"\"}},{\"name\":{\"type\":\"XS_STRING\",\"name\":\"relType\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"RelationPersonQuotation\"}},{\"name\":{\"type\":\"XS_STRING\",\"name\":\"rule\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"PersQuote2\"}},{\"name\":{\"type\":\"XS_STRING\",\"name\":\"class\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"http://ontology.ontotext.com/taxonomy/RelationPersonQuotation\"}},{\"name\":{\"type\":\"XS_STRING\",\"name\":\"inst\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"http://data.ontotext.com/publishing/RelationPersonQuotation/_what_i_am_keen_to_see_are_the_reasons_why_they_chose_me_one_can_never_really_be_one_s_own_reader_he_told_a_news_conference_in_paris_even_more_so_because_i_have_the_impression_of_writing_the_same_book_for_45_years_\"}},{\"name\":{\"type\":\"XS_STRING\",\"name\":\"string\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"\\\"What I am keen to see are the reasons why they chose me ... One can never really be one's own reader,\\\" he told a news conference in Paris. \\\"Even more so because I have the impression of writing the same book for 45 years.\\\"\"}}],\"id\":\"30652\",\"startnode\":\"1525\",\"endnode\":\"1748\",\"type\":\"RelationPersonQuotation\",\"status\":\"Suggested\",\"generated\":false},{\"feature-set\":[{\"name\":{\"type\":\"XS_STRING\",\"name\":\"personInst\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"http://ontology.ontotext.com/resource/tsmjbgy4b5kw\"}},{\"name\":{\"type\":\"XS_STRING\",\"name\":\"personStr\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"Manuel Valls\"}},{\"name\":{\"type\":\"XS_STRING\",\"name\":\"quotationStr\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"\\\"He is undoubtedly one of the greatest writers of recent years, of the early 21st century. This is well-deserved for a writer who is moreover discreet, as is much of his excellent work.\\\"\"}},{\"name\":{\"type\":\"XS_STRING\",\"name\":\"relType\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"RelationPersonQuotation\"}},{\"name\":{\"type\":\"XS_STRING\",\"name\":\"rule\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"PersQuote3\"}},{\"name\":{\"type\":\"XS_STRING\",\"name\":\"class\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"http://ontology.ontotext.com/taxonomy/RelationPersonQuotation\"}},{\"name\":{\"type\":\"XS_STRING\",\"name\":\"inst\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"http://data.ontotext.com/publishing/RelationPersonQuotation/manuel_valls_said_he_is_undoubtedly_one_of_the_greatest_writers_of_recent_years_of_the_early_21st_century_this_is_well_deserved_for_a_writer_who_is_moreover_discreet_as_is_much_of_his_excellent_work_\"}},{\"name\":{\"type\":\"XS_STRING\",\"name\":\"string\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"Manuel Valls said: \\\"He is undoubtedly one of the greatest writers of recent years, of the early 21st century. This is well-deserved for a writer who is moreover discreet, as is much of his excellent work.\\\"\"}}],\"id\":\"30653\",\"startnode\":\"1842\",\"endnode\":\"2047\",\"type\":\"RelationPersonQuotation\",\"status\":\"Suggested\",\"generated\":false},{\"feature-set\":[{\"name\":{\"type\":\"XS_STRING\",\"name\":\"personInst\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"http://data.ontotext.com/publishing/person/Alan_Morris\"}},{\"name\":{\"type\":\"XS_STRING\",\"name\":\"personStr\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"Alan Morris\"}},{\"name\":{\"type\":\"XS_STRING\",\"name\":\"quotationStr\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"\\\"Ambiguity, this is one of the characteristics of his work. There is an attempt to try and reconstruct some kind of story from the past, but it inevitably proves impossible.\\\"\"}},{\"name\":{\"type\":\"XS_STRING\",\"name\":\"relType\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"RelationPersonQuotation\"}},{\"name\":{\"type\":\"XS_STRING\",\"name\":\"rule\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"PersQuote1\"}},{\"name\":{\"type\":\"XS_STRING\",\"name\":\"class\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"http://ontology.ontotext.com/taxonomy/RelationPersonQuotation\"}},{\"name\":{\"type\":\"XS_STRING\",\"name\":\"inst\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"http://data.ontotext.com/publishing/RelationPersonQuotation/_ambiguity_this_is_one_of_the_characteristics_of_his_work_said_dr_alan_morris_senior_lecturer_in_french_at_strathclyde_university_there_is_an_attempt_to_try_and_reconstruct_some_kind_of_story_from_the_past_but_it_inevitably_proves_impossible_\"}},{\"name\":{\"type\":\"XS_STRING\",\"name\":\"string\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"\\\"Ambiguity, this is one of the characteristics of his work,\\\" said Dr. Alan Morris, senior lecturer in French at Strathclyde University. \\\"There is an attempt to try and reconstruct some kind of story from the past, but it inevitably proves impossible.\\\"\"}}],\"id\":\"30654\",\"startnode\":\"2439\",\"endnode\":\"2690\",\"type\":\"RelationPersonQuotation\",\"status\":\"Suggested\",\"generated\":false},{\"feature-set\":[{\"name\":{\"type\":\"XS_STRING\",\"name\":\"personInst\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"http://ontology.ontotext.com/resource/tsmz8flkoz5s\"}},{\"name\":{\"type\":\"XS_STRING\",\"name\":\"personStr\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"Englund\"}},{\"name\":{\"type\":\"XS_STRING\",\"name\":\"quotationStr\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"\\\"Of the unique things about him, one is of course his style which is very precise, very economical. He writes small, short, very elegant sentences. And he returns to generally the same topics again and again, simply because these topics cannot be exhausted.\\\"\"}},{\"name\":{\"type\":\"XS_STRING\",\"name\":\"relType\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"RelationPersonQuotation\"}},{\"name\":{\"type\":\"XS_STRING\",\"name\":\"rule\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"PersQuote2\"}},{\"name\":{\"type\":\"XS_STRING\",\"name\":\"class\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"http://ontology.ontotext.com/taxonomy/RelationPersonQuotation\"}},{\"name\":{\"type\":\"XS_STRING\",\"name\":\"inst\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"http://data.ontotext.com/publishing/RelationPersonQuotation/_of_the_unique_things_about_him_one_is_of_course_his_style_which_is_very_precise_very_economical_he_writes_small_short_very_elegant_sentences_englund_said_and_he_returns_to_generally_the_same_topics_again_and_again_simply_because_these_topics_cannot_be_exhausted_\"}},{\"name\":{\"type\":\"XS_STRING\",\"name\":\"string\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"\\\"Of the unique things about him, one is of course his style which is very precise, very economical. He writes small, short, very elegant sentences,\\\" Englund said. \\\"And he returns to generally the same topics again and again, simply because these topics cannot be exhausted.\\\"\"}}],\"id\":\"30655\",\"startnode\":\"2868\",\"endnode\":\"3142\",\"type\":\"RelationPersonQuotation\",\"status\":\"Suggested\",\"generated\":false},{\"feature-set\":[{\"name\":{\"type\":\"XS_STRING\",\"name\":\"personInst\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"http://ontology.ontotext.com/resource/tsk803t3db0g\"}},{\"name\":{\"type\":\"XS_STRING\",\"name\":\"personStr\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"Modiano\"}},{\"name\":{\"type\":\"XS_STRING\",\"name\":\"quotationStr\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"\\\"After each novel, I have the impression that I have cleared it all away. But I know I'll come back over and over again to tiny details, little things that are part of what I am.\\\"\"}},{\"name\":{\"type\":\"XS_STRING\",\"name\":\"relType\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"RelationPersonQuotation\"}},{\"name\":{\"type\":\"XS_STRING\",\"name\":\"rule\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"PersQuote2\"}},{\"name\":{\"type\":\"XS_STRING\",\"name\":\"class\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"http://ontology.ontotext.com/taxonomy/RelationPersonQuotation\"}},{\"name\":{\"type\":\"XS_STRING\",\"name\":\"inst\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"http://data.ontotext.com/publishing/RelationPersonQuotation/_after_each_novel_i_have_the_impression_that_i_have_cleared_it_all_away_modiano_told_france_today_in_a_2011_interview_but_i_know_i_ll_come_back_over_and_over_again_to_tiny_details_little_things_that_are_part_of_what_i_am_\"}},{\"name\":{\"type\":\"XS_STRING\",\"name\":\"string\"},\"value\":{\"type\":\"XS_STRING\",\"value\":\"\\\"After each novel, I have the impression that I have cleared it all away,\\\" Modiano told France Today in a 2011 interview. \\\"But I know I'll come back over and over again to tiny details, little things that are part of what I am.\\\"\"}}],\"id\":\"30656\",\"startnode\":\"3539\",\"endnode\":\"3767\",\"type\":\"RelationPersonQuotation\",\"status\":\"Suggested\",\"generated\":false},{\"feature-set\":[{\"name\":{\"type\":\"XS_STRING\",\"name\":\"string\"},\"va