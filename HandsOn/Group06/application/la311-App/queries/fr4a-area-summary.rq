PREFIX la311: <http://linkeddata.la311.com/ontology#>
PREFIX geo:   <http://www.opengis.net/ont/geosparql#>
PREFIX rdfs:  <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:   <http://www.w3.org/2001/XMLSchema#>

SELECT ?requestType ?status (COUNT(?sr) AS ?n)
WHERE {
  ?sr la311:requestType ?requestType ;
      la311:status ?status ;
      la311:createdDate ?created ;
      la311:hasLocation/la311:isWithin/la311:cd 9 .
  FILTER (?created >= "2025-01-01T00:00:00Z"^^xsd:dateTime
       && ?created <  "2026-01-01T00:00:00Z"^^xsd:dateTime)
}
GROUP BY ?requestType ?status
ORDER BY DESC(?n)
