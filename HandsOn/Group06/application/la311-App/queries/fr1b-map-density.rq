PREFIX la311: <http://linkeddata.la311.com/ontology#>
PREFIX geo:   <http://www.opengis.net/ont/geosparql#>
PREFIX rdfs:  <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:   <http://www.w3.org/2001/XMLSchema#>

SELECT ?cellLat ?cellLon (COUNT(?sr) AS ?n)
WHERE {
  VALUES ?requestType { "Bulky Items" "Graffiti Removal" }
  ?sr la311:requestType ?requestType ;
      la311:createdDate ?created ;
      la311:hasLocation ?loc .
  ?loc la311:latitude ?lat ;
       la311:longitude ?lon .
  FILTER (?created >= "2025-01-01T00:00:00Z"^^xsd:dateTime
       && ?created <  "2026-01-01T00:00:00Z"^^xsd:dateTime)
  BIND (FLOOR(?lat / 0.005) * 0.005 + 0.0025 AS ?cellLat)
  BIND (FLOOR(?lon / 0.005) * 0.005 + 0.0025 AS ?cellLon)
}
GROUP BY ?cellLat ?cellLon
